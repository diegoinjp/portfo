---
import Title from '../Title.astro';
import Stats from './Stats.astro';
import Carousel from '../Carousel';
---

<div id="profile">
  <Title styles="mb-6">Profile</Title>
  <div class="flex flex-col gap-12">
    <div class="grid gap-12 lg:grid-cols-3 lg:gap-12">
      <!-- placeholder image -->
      <Carousel client:visible />
      <div class="flex flex-col items-start gap-8 sm:gap-10 lg:col-span-2">
        <p class="text-primary-950/70 dark:text-primary-200/70 sm:text-lg lg:text-justify">
          Born in Argentina in 1989, I am a certified translator with over a decade of experience and top quality ratings. Drawing from a broad international background, I collaborate with Japanese and global organizations on
          translation and localization projects, facilitating interactions and growth in a variety of markets. <br /><br
          />I specialize in business and media, but I am also active in other fields including tourism, marketing, education, and international cooperation (ODA). Through consistent terminology management and quality assurance, I deliver texts that not only meet clients’ needs but also create impactful experiences.
        </p>
      </div>
    </div>
    <Stats />
  </div>
</div>
